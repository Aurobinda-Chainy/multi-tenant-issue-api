generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Issue {
  id             String   @id @default(uuid())
  title          String
  description    String?
  status         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
